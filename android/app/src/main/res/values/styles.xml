<resources>
    <style name="Theme.Seipseip" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#1E4933</item>
    </style>

    <style name="Theme.Seipseip.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F6F4EF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Seipseip</item>
    </style>
</resources>
