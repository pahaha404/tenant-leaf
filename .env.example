# server/api
POSTGRES_DB=tenant_leaf
POSTGRES_USER=tenant_leaf
POSTGRES_PASSWORD=tenant_leaf_local
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/tenant_leaf

# Local object storage used by server/api and server/ai-worker
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://10.0.2.2:9000
OBJECT_STORAGE_ACCESS_KEY=tenant_leaf
OBJECT_STORAGE_SECRET_KEY=tenant_leaf_minio_local
OBJECT_STORAGE_BUCKET=tenant-leaf-media
MINIO_ROOT_USER=tenant_leaf
MINIO_ROOT_PASSWORD=tenant_leaf_minio_local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# server/ai-worker
AI_WORKER_DATABASE_DSN=postgresql://tenant_leaf:tenant_leaf_local@localhost:5432/tenant_leaf
AI_WORKER_POLL_SECONDS=2
AI_WORKER_MODEL_TIMEOUT_SECONDS=1800
GEMINI_API_KEY=
AI_WORKER_GEMINI_MODEL=gemini-3.5-flash-lite
AI_WORKER_GEMINI_DEFECT_MODEL=gemini-3.5-flash-lite
AI_WORKER_GEMINI_REJECT_CONFIDENCE=0.90
# Optional. Defaults to <repository>/ai/ai-video-defect.
# AI_MODEL_MODULE_ROOT=C:/path/to/tenant-leaf/ai/ai-video-defect

# android: local.properties or encrypted CI secrets only
API_BASE_URL=http://10.0.2.2:8080
